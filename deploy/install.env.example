# Your installation's settings, for tools/ship-pi.sh. Copy this file to private/install.env (git
# leaves the private/ folder alone) and fill it in.

# The Pi: how to reach it over SSH, and the folder the apps live in there
PI=you@your-pi
PI_DIR=/home/you/bassapps

# The sign-in service on the Pi
ACCOUNT_URL=https://account.example.net      # its own address, as browsers see it
APPS='[{"id":"mail","name":"Mail","url":"https://mail.example.net"}]'
TIME_ZONE=UTC                                # e.g. Europe/London
