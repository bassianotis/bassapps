# Bassapps with Mail (compose.yml). Copy this file to .env and fill it in.

# Where people reach the two. As they are here, they work on this computer only. On a server, use
# your HTTPS addresses (e.g. https://account.example.net and https://mail.example.net), point your
# proxy at ports 3102 and 3100, and set SECURE_COOKIES=1 and TRUST_PROXY=1.
ACCOUNT_URL=http://localhost:3102
MAIL_URL=http://localhost:3100
SECURE_COOKIES=0
TRUST_PROXY=0

# The Bassapps login that may use Mail (several: comma-separated). After starting, create it with
#   docker compose exec -it account node service/bin/bassapps.ts reset-passphrase <username>
MAIL_USERS=you

# For the dates in sign-in emails, e.g. Europe/London
TZ=UTC

# Optional
# MAIL_SOURCE=../electronic-mail     build Mail from your own copy instead of GitHub
# ACCOUNT_PORT=3102
# MAIL_PORT=3100
